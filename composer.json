{
  "name": "novicell/wordpress-sage-starter",
  "type": "project",
  "license": "MIT",
  "description": "Reusable WordPress starter built on Bedrock and Sage.",
  "homepage": "https://github.com/Carlos-CMP/wp-sage-starter",
  "authors": [
    {
      "name": "Novicell"
    }
  ],
  "keywords": [
    "bedrock", "composer", "roots", "wordpress-composer", "wordpress", "wp-composer", "wp-config", "wp"
  ],
  "support": {
    "issues": "https://github.com/Carlos-CMP/wp-sage-starter/issues"
  },
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/sage": "^11.2",
    "roots/wordpress": "^7.1",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/themes/starter-theme/": [
        "roots/sage"
      ],
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "lint": "@php vendor/bin/pint --test",
    "lint:fix": "@php vendor/bin/pint"
  }
}
